# ============================================================
# 生产环境配置模板(内网部署)
# 复制为 .env.production 并填齐全部必填项;应用启动强校验,缺项容器起不来(fail fast)。
# 完整部署步骤见 docker/DEPLOY-OFFLINE.md 与 docs/deployment.md。
# ============================================================

# --- 必填 ---

# 内网 PostgreSQL 16 连接串(空库即可,容器启动时自动迁移建表)
DATABASE_URL="postgresql://budget:<强口令>@<pg主机内网IP>:5432/budget?schema=public"

# 必须 false:生产禁止 mock 认证(MOCK_AUTH=true 会启动即崩,属预期防护,见 src/lib/boot-guard.ts)
MOCK_AUTH=false

# Authentik OIDC:issuer = <authentik地址>/application/o/<slug>/,末尾必须带 /
AUTHENTIK_ISSUER="http://<authentik内网地址>/application/o/budget/"
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""

# 会话 JWT 签名密钥:openssl rand -base64 32 生成(≥32 字符);
# 视同密码保管——泄露=可伪造登录态,更换=全体会话失效(重部署/升级不要换)
AUTH_SECRET=""

# 用户浏览器实际访问的地址(登录 redirect_uri 由它拼接;反代终止 TLS 则写 https://…)
APP_BASE_URL="http://<预算系统对外地址>:3000"

# --- 可选(默认值见 src/lib/env.ts) ---

# false 跳过容器内迁移(改由外部 Job 统一执行时用)
# RUN_MIGRATIONS=false

# Prisma 连接池上限(默认 10)
# DB_CONNECTION_LIMIT=10

# 容量与限流闸门
# 附件单文件上限(字节);默认 50MB
# MAX_ATTACHMENT_BYTES=52428800
# 结算单/模板导入上传的声明大小上限(字节);默认 10MB
# MAX_IMPORT_BYTES=10485760
# JSON 请求体上限(字节);默认 1MB
# MAX_BODY_BYTES=1048576
# 附件 zip 打包/导出的总字节上限;默认 512MB
# MAX_EXPORT_TOTAL_BYTES=536870912
# 统计自定义导出最大行数;默认 10 万
# MAX_EXPORT_ROWS=100000
