# Database
DATABASE_URL="postgresql://budget:budget@localhost:5434/budget?schema=public"

# Runtime
NODE_ENV=development
APP_PORT=3000

# Auth — 本地开发用 mock;接入 SSO 时改为 false 并填齐以下变量(详见 AGENTS.md 认证体系)
MOCK_AUTH=true
AUTHENTIK_ISSUER="http://localhost:9000/application/o/budget/"
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""
AUTH_SECRET=""          # openssl rand -base64 32
APP_BASE_URL="http://localhost:3000"

# 附件(报销凭证)上传配置
# 单文件大小上限(字节);默认 50MB,超过会被服务端拒绝(413)。
# MAX_ATTACHMENT_BYTES=52428800
# 允许的文件类型在代码内维护(src/lib/attachments/config.ts),如需调整改代码。

# 容量与限流闸门(默认值见 src/lib/env.ts,按需覆盖)
# 结算单/模板导入上传的声明大小上限(字节);默认 10MB。
# MAX_IMPORT_BYTES=10485760
# JSON 请求体上限(字节);默认 1MB。
# MAX_BODY_BYTES=1048576
# 附件 zip 打包/导出的总字节上限;默认 512MB(另有条数上限 500 在代码内)。
# MAX_EXPORT_TOTAL_BYTES=536870912
# 统计自定义导出最大行数;默认 10 万。
# MAX_EXPORT_ROWS=100000
